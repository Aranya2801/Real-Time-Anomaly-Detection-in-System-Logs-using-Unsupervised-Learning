# ═══════════════════════════════════════════════════════════════
# LogSentinel AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
WORKERS=4
APP_VERSION=1.0.0

# ── Security ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_SECRETS_MANAGER
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logsentinel
POSTGRES_USER=logsentinel
POSTGRES_PASSWORD=logsentinel_dev_password
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ── Elasticsearch ────────────────────────────────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_LOGS=logsentinel-logs
ELASTICSEARCH_INDEX_ANOMALIES=logsentinel-anomalies

# ── Kafka ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_LOGS=raw-logs
KAFKA_TOPIC_PARSED_LOGS=parsed-logs
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_TOPIC_ALERTS=alerts
KAFKA_CONSUMER_GROUP=logsentinel-ml
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ── ML Models ────────────────────────────────────────────────────
MODELS_DIR=ml_models/saved
FEATURE_DIM=128
SEQUENCE_LEN=50
BATCH_SIZE=512

# Ensemble weights (must sum to 1.0)
WEIGHT_ISOLATION_FOREST=0.15
WEIGHT_ONE_CLASS_SVM=0.10
WEIGHT_LOF=0.05
WEIGHT_LSTM_AE=0.25
WEIGHT_TRANSFORMER_AE=0.30
WEIGHT_DEEP_SVDD=0.05
WEIGHT_RIVER_ONLINE=0.10

# Anomaly thresholds
ANOMALY_THRESHOLD_WARNING=0.60
ANOMALY_THRESHOLD_CRITICAL=0.80
ANOMALY_THRESHOLD_EMERGENCY=0.95
ADAPTIVE_THRESHOLD_WINDOW=10000
ADAPTIVE_THRESHOLD_PERCENTILE=99.5

# ── Alerting — Email ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=logsentinel@yourdomain.com
# Comma-separated list
ALERT_EMAIL_RECIPIENTS=security@yourdomain.com

# ── Alerting — Slack ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts

# ── Alerting — Discord ───────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Alerting — Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert deduplication (seconds)
ALERT_DEDUP_WINDOW_SECONDS=300

# ── LLM (Ollama) ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=120
LLM_MAX_CONTEXT_LOGS=20

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=logsentinel

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_BURST=100

# ── Reports ──────────────────────────────────────────────────────
REPORTS_DIR=reports/generated
REPORT_RETENTION_DAYS=90

# ── Feature Flags ────────────────────────────────────────────────
ENABLE_LLM_INVESTIGATION=true
ENABLE_GNN_MODEL=false
ENABLE_DIGITAL_TWIN=false
ENABLE_FEDERATED_LEARNING=false
ENABLE_SECURITY_SCAN=true

# ── Log Rate (for demo producer) ─────────────────────────────────
LOG_RATE=100
